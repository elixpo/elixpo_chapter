From f4696dcfde0621254516b8fa94d821df96472583 Mon Sep 17 00:00:00 2001
From: Ayushman Bhattacharya <ayushman.elixpo@gmail.com>
Date: Sun, 1 Nov 2026 13:14:34 +0530
Subject: [PATCH] Add magic for RV565 video

RV565 is a frame-independent RGB565 video container for microcontroller
displays: a 12-byte little-endian header followed by length-prefixed zlib
frames. Specification:
https://github.com/elixpo/rv565/blob/main/docs/FORMAT.md

Adds a test file (a 24-frame synthetic test pattern).
---
 magic/Magdir/animation |  23 +++++++++++++++++++++++
 tests/Makefile.am      |   2 ++
 tests/rv565.result     |   1 +
 tests/rv565.testfile   | Bin 0 -> 6322 bytes
 4 files changed, 26 insertions(+)
 create mode 100644 tests/rv565.result
 create mode 100644 tests/rv565.testfile

diff --git a/magic/Magdir/animation b/magic/Magdir/animation
index 4a73e72..b7cec57 100644
--- a/magic/Magdir/animation
+++ b/magic/Magdir/animation
@@ -1251,3 +1251,26 @@
 >14	belong	!0	\b, XOR obfuscation key %d
 !:mime	application/x-cubism-archive
 !:ext	cmo3/can3
+
+#------------------------------------------------------------------------------
+# rv565:  file(1) magic for RV565 frame-independent RGB565 video
+#
+# RV565 is a container for microcontroller displays: a 12-byte little-endian
+# header, then per frame a u32 length and a zlib stream that inflates to
+# width*height big-endian RGB565 pixels.
+# Specification: https://github.com/elixpo/rv565/blob/main/docs/FORMAT.md
+# Paper: https://arxiv.org/abs/2610.35935
+#
+# The 3-byte magic is short, so also require version 6, a frame rate of
+# 1-30, and a zlib header (0x78) on the first frame.
+0	string		RV5
+>3	byte		6
+>>8	ubyte		>0
+>>>8	ubyte		<31
+>>>>16	ubyte		0x78		RV565 video
+!:mime	video/x-rv565
+!:ext	rv565
+>>>>>4		uleshort	x		\b, %u
+>>>>>6		uleshort	x		\bx%u
+>>>>>8		ubyte		x		\b, %u fps
+>>>>>10		uleshort	x		\b, %u frames
diff --git a/tests/Makefile.am b/tests/Makefile.am
index 5079b3a..4dbd40d 100644
--- a/tests/Makefile.am
+++ b/tests/Makefile.am
@@ -160,6 +160,8 @@ rpm-v3.0-bin-x86_64.result \
 rpm-v3.0-bin-x86_64.testfile \
 rpm-v3.0-src.result \
 rpm-v3.0-src.testfile \
+rv565.result \
+rv565.testfile \
 searchbug.magic \
 searchbug.result \
 searchbug.testfile \
diff --git a/tests/rv565.result b/tests/rv565.result
new file mode 100644
index 0000000..7dc1ed6
--- /dev/null
+++ b/tests/rv565.result
@@ -0,0 +1 @@
+RV565 video, 180x135, 24 fps, 24 frames
\ No newline at end of file
diff --git a/tests/rv565.testfile b/tests/rv565.testfile
new file mode 100644
index 0000000000000000000000000000000000000000..f2758934b7d22737ff312ba90c181761f8ad529b
