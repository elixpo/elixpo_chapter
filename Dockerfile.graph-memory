FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/lixsearch

WORKDIR /app

COPY requirements-graph-memory.txt /app/
RUN pip install --no-cache-dir -r requirements-graph-memory.txt

COPY lixsearch /app/lixsearch

RUN mkdir -p /app/data/graph

CMD ["python", "-m", "graphMemory.worker"]
